{
  "description": "Prototype : le crochet de démarrage par PowerShell (passe B), et un crochet qui appelle un programme absent, déclenché seulement par /clear (tâche 24).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/client/c360.mjs\" --data \"${CLAUDE_PLUGIN_DATA}/../base-studio-360d\" etat --crochet --source essai-powershell",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "c360-programme-absent",
            "args": [
              "etat",
              "--crochet"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
